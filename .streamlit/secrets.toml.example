# Copy to secrets.toml for local cloud-mode testing, or paste the same keys into
# Streamlit Community Cloud → app settings → Secrets. NEVER commit secrets.toml.

# Long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
password_pepper = "REPLACE-ME"     # mixed into every hash; a leaked sheet is useless without it
session_secret  = "REPLACE-ME"     # signs session tokens

# Who may approve accounts and see the Admin page.
admin_emails = ["your.name@truecorp.co.th"]

# Drive folder holding m<N>_leads_<date>.csv — the id is the last path segment
# of the folder URL. Share the folder (or each snapshot) with client_email below
# as Viewer.
drive_folder_id = "REPLACE-ME"

# The Google Sheet holding accounts. Share it with client_email as EDITOR.
identity_sheet_id = "REPLACE-ME"

# The Google Sheet the call log is appended to. A SEPARATE spreadsheet from the
# identity one, share it with client_email as EDITOR. Separate because this one
# gets shared onward with whoever runs the analysis, and the identity sheet
# holds password hashes. Unset means AEs can see leads but cannot log calls.
call_log_sheet_id = "REPLACE-ME"

# The Cloudflare shell's origin -- scheme and host only, no path, no trailing
# slash. The session token is posted ONLY to this origin; unset means sign-in
# does not survive a refresh inside the shell (the app still works opened
# directly).
shell_origin = "https://REPLACE-ME.pages.dev"

# Service account key JSON, field by field.
[gcp_service_account]
type = "service_account"
project_id = "REPLACE-ME"
private_key_id = "REPLACE-ME"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"
client_email = "REPLACE-ME@REPLACE-ME.iam.gserviceaccount.com"
client_id = "REPLACE-ME"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE-ME"
universe_domain = "googleapis.com"
